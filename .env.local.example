# Example environment variables for Brevo, GitHub, analytics, and Redis-backed counters.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login_here
BREVO_SMTP_PASSWORD=your_brevo_smtp_password_here
BREVO_API_KEY=your_optional_brevo_api_key_here
GITHUB_TOKEN=your_github_pat_here
NEXT_PUBLIC_SITE_URL=https://varuntej.online
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
